{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-local-bootstrap",
  "description": "Only the bundled local pages (bootstrap shell and the version panel) can use Tauri core APIs. The Harness HTTP origin receives no IPC permissions.",
  "webviews": ["main", "info"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging"
  ]
}
